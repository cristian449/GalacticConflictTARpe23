@model InterGalacticConflict.Models.Profiles.ProfileRegisterViewModel
<div>
	<h1>Customize your profile:</h1>
</div>

<div class="row">
	<div class="col-md-12">
		<form method="post">
			<div asp-validation-summary="All" class="text-danger">

				<input type="hidden" asp-for="ApplicationUserID"/>
				<input type="hidden" asp-for="Credits" />
				<input type="hidden" asp-for="BasicResource" />
				<input type="hidden" asp-for="Victories" />
				<input type="hidden" asp-for="CurrentStatus" />
				<input type="hidden" asp-for="ProfileType" />


				<div class="form-group">
					<label asp-for="ScreenName"></label>
					<input asp-for="ScreenName" class="form-control"/>
					<span asp-validation-for="ScreenName" class="text-danger"></span>
				</div>


				@* ADD ASP ACTION FOR BUTTION FOR NEW PLAYER PROFILE *@
				<button type="submit" asp-route-id="" asp-action="NewProfile">
					Yes, this is my screename and I'm ready to play! BUMBOI
				</button>

			</div>
		</form>
	</div>
</div>
